# Files die NICHT als public static assets hochgeladen werden sollen.
# Syntax wie .gitignore.

# Worker-Code (sonst public exposed)
_worker.js

# Wrangler-Config
wrangler.jsonc
wrangler.toml

# Git-Internals (waren bisher fälschlicherweise als Asset hochgeladen)
.git/
.gitignore
.gitattributes

# Wrangler-Cache
.wrangler/

# macOS
.DS_Store

# Altfragenpool — liegt in KV, nicht im Repo. Lokal existiert die Datei aber
# noch; ohne diesen Eintrag lädt ein lokales `wrangler deploy` sie als
# öffentliches Asset hoch (der Cloud-Build sieht sie nicht, weil gitignored).
pool-import.txt

# Node/Logs, falls lokal vorhanden
node_modules/
*.log
